# SereneMind Backend — copy to .env and fill in values
# NEVER commit .env to git
# NEVER put real API keys in this file — use .env only

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/serenemind.db

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRE_DAYS=7
AUTH_DISABLED=true
# Shared secret for POST /auth/provision (header: X-Internal-Provision-Secret).
# Leave empty for localhost-only access during local Phase 2 development.
INTERNAL_PROVISION_SECRET=change-me-to-a-long-random-internal-secret

# ─── AI Services ───────────────────────────────────────────────────────────
AI_SERVICE_URL=http://127.0.0.1:8000
OPENAI_API_KEY=PASTE_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ─── Pinecone (Vector Memory / RAG) ─────────────────────────────────────────
PINECONE_API_KEY=PASTE_PINECONE_KEY_HERE
PINECONE_INDEX_NAME=serenemind-memories-e5
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=1024
PINECONE_ENABLED=true
EMBEDDING_PROVIDER=auto
PINECONE_EMBED_MODEL=multilingual-e5-large

# ─── Memory Settings ─────────────────────────────────────────────────────────
HISTORY_WINDOW=6
SESSION_SUMMARY_INTERVAL=20
RAG_TOP_K=2
RAG_SIMILARITY_THRESHOLD=0.80
PROMPT_MAX_SUMMARY_CHARS=400

# ─── Ollama (local LLM — replaces OpenAI chat only) ─────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_FALLBACK_MODEL=mistral
OLLAMA_ENABLED=true
OLLAMA_MAX_TOKENS=120
OLLAMA_MAX_TOKENS_CRISIS=180
