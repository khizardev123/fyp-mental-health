# SereneMind — copy to .env (never commit .env)

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
AUTH_DISABLED=true

# OpenAI (optional — richer replies + embeddings for Pinecone)
OPENAI_API_KEY=

# Pinecone
PINECONE_API_KEY=PASTE_MY_KEY_HERE
PINECONE_ENABLED=false
PINECONE_INDEX_NAME=serenemind-memories
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
