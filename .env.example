# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/serenemind

# Secret for signing JWTs (use a long random string in production)
# Must match services/avatar-service JWT_SECRET when using SereneMind proxies.
JWT_SECRET=change-me-to-a-long-random-secret

# SereneMind backend services (server-side proxy only)
AVATAR_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_URL=http://127.0.0.1:8000
